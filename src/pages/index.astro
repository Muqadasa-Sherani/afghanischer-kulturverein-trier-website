---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Start">
  <section class="container hero">
    <h1>Zwei Kulturen, eine Heimat</h1>
    <p>
      Platzhalter: Der Afghanische Kulturverein Trier e.V. bringt afghanische und deutsche Kultur
      zusammen.
    </p>
  </section>
</BaseLayout>

<style>
  .hero {
    padding-block: 4rem;
  }
  h1 {
    font-size: clamp(2.2rem, 5vw, 3.5rem);
    color: var(--lapis-900);
    margin: 0 0 1rem;
  }
  p {
    font-size: 1.2rem;
    color: var(--muted);
    max-width: 38em;
  }
</style>